{
    "luci-app-momo": {
        "description": "Grant access to momo procedures",
        "read": {
            "uci": [ "momo" ],
            "ubus": {
                "rc": [ "list" ],
                "luci.momo": [ "get_paths", "version", "profile", "get_identifiers", "get_log" ]
            },
            "file": {
                "/etc/momo/profiles/*": ["list", "read"],
                "/etc/momo/profiles/*.json": ["read"],
                "/etc/momo/subscriptions/*.json": ["read"],
                "/etc/momo/run/config.json": ["read"],
                "/tmp/momo_editor.json": ["read"],
                "/var/log/momo/*.log": ["read"],
                "/tmp/log/momo/*.log": ["read"]
            }
        },
        "write": {
            "uci": [ "momo" ],
            "ubus": {
                "rc": [ "init" ],
                "luci.momo": [ "update_subscription", "update_singbox", "check_profile", "format_profile", "api", "debug" ]
            },
            "file": {
                "/etc/momo/profiles/*.json": ["write"],
                "/etc/momo/subscriptions/*.json": ["write"],
                "/etc/momo/run/config.json": ["write"],
                "/tmp/momo_editor.json": ["write"],
                "/var/log/momo/*.log": ["write"],
                "/tmp/log/momo/*.log": ["write"]
            }
        }
    }
}