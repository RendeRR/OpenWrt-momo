#!/usr/bin/ucode

'use strict';

import { open, popen, stat } from 'fs';
import { PATHS, get_paths, merge_exists, get_users, get_groups, get_cgroups, load_profile } from '/etc/momo/ucode/include.uc';

function sh_quote(str) {
	return "'" + replace('' + (str ?? ''), /'/g, "'\\''") + "'";
}

function strip_ansi(output) {
	output = replace(output, /\x1b\[[0-9;]*[a-zA-Z]/g, '');
	output = replace(output, /\[[0-9;]+m/g, '');
	output = replace(output, /\[[0-9]{4}\][[:space:]]*/g, ': ');
	output = replace(output, ' at /tmp/momo_editor.json', '');
	return output;
}

const methods = {
	get_paths: {
		call: function() {
			return get_paths();
		}
	},
	version: {
		call: function() {
			let process;
			let app = '';
			if (stat('/bin/opkg')) {
				process = popen(`opkg list-installed luci-app-momo | cut -d ' ' -f 3`);
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			} else if (stat('/usr/bin/apk')) {
				process = popen(`apk list -I luci-app-momo | cut -d ' ' -f 1 | cut -d '-' -f 4-`);
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			}
			let core = '';
			process = popen(`/usr/bin/sing-box version 2>/dev/null | grep sing-box | cut -d ' ' -f 3`);
			if (process) {
				core = trim(process.read('all'));
				process.close();
			}
			return { app: app, core: core };
		}
	},
	profile: {
		args: { defaults: {} },
		call: function(req) {
			const defaults = req.args?.defaults ?? {};
			const profile = load_profile();
			return merge_exists(defaults, profile);
		}
	},
	get_log: {
		args: { type: 'type', max_bytes: 0 },
		call: function(req) {
			const log_type = req.args?.type ?? 'app';
			const req_max = int(req.args?.max_bytes ?? 0);
			const max_bytes = (req_max > 0) ? req_max : 131072;
			const log_path = (log_type == 'core') ? PATHS.core_log_path : PATHS.app_log_path;
			const st = stat(log_path);
			if (!st) {
				return { content: '', size: 0, mtime: 0 };
			}
			const f = open(log_path, 'r');
			if (!f) {
				return { content: '', size: st.size, mtime: st.mtime };
			}
			if (st.size > max_bytes) {
				f.seek(st.size - max_bytes);
				f.read('line');
			}
			const content = f.read('all') ?? '';
			f.close();
			return { content: content, size: st.size, mtime: st.mtime };
		}
	},
	update_subscription: {
		args: { section_id: 'section_id' },
		call: function(req) {
			let success = false;
			const section_id = req.args?.section_id;
			if (section_id && match(section_id, /^[a-zA-Z0-9_]+$/)) {
				success = system(['/etc/init.d/momo', 'update_subscription', section_id]) == 0;
			}
			return { success: success };
		}
	},
	update_singbox: {
		args: { version: 'version', mirror: 'mirror' },
		call: function(req) {
			const version = req.args?.version;
			const mirror = req.args?.mirror ?? 'auto';
			if (!version || !match(version, /^[a-zA-Z0-9._-]+$/)) {
				return { result: 'Invalid version specified' };
			}

			const raw_url = 'https://raw.githubusercontent.com/SagerNet/sing-box/refs/heads/main/docs/installation/tools/install.sh';
			const q_ver = sh_quote(version);
			let cmd = '';

			if (mirror == 'ghfast') {
				cmd = `{ cd /tmp && curl -fsSL --connect-timeout 15 -o singbox_install.sh "https://ghfast.top/${raw_url}" && sed -i 's|https://github.com/|https://ghfast.top/https://github.com/|g' singbox_install.sh && sh singbox_install.sh --version ${q_ver} && rm -f singbox_install.sh && /etc/init.d/momo restart; } 2>&1`;
			} else if (mirror == 'ghproxy') {
				cmd = `{ cd /tmp && curl -fsSL --connect-timeout 15 -o singbox_install.sh "https://gh-proxy.com/${raw_url}" && sed -i 's|https://github.com/|https://gh-proxy.com/https://github.com/|g' singbox_install.sh && sh singbox_install.sh --version ${q_ver} && rm -f singbox_install.sh && /etc/init.d/momo restart; } 2>&1`;
			} else if (mirror == 'direct') {
				cmd = `{ cd /tmp && (curl -fsSL --connect-timeout 15 "https://sing-box.app/install.sh" || curl -fsSL --connect-timeout 15 "${raw_url}") | sh -s -- --version ${q_ver} && /etc/init.d/momo restart; } 2>&1`;
			} else {
				cmd = `{ cd /tmp && (curl -fsSL --connect-timeout 10 -o singbox_install.sh "https://sing-box.app/install.sh" || curl -fsSL --connect-timeout 10 -o singbox_install.sh "${raw_url}" || curl -fsSL --connect-timeout 15 -o singbox_install.sh "https://ghfast.top/${raw_url}" || curl -fsSL --connect-timeout 15 -o singbox_install.sh "https://gh-proxy.com/${raw_url}") && (sh singbox_install.sh --version ${q_ver} || (echo "Direct GitHub download failed, retrying via mirror (ghfast.top)..." && sed 's|https://github.com/|https://ghfast.top/https://github.com/|g' singbox_install.sh > singbox_install_mirror.sh && sh singbox_install_mirror.sh --version ${q_ver}) || (echo "Retrying via backup mirror (gh-proxy.com)..." && sed 's|https://github.com/|https://gh-proxy.com/https://github.com/|g' singbox_install.sh > singbox_install_mirror.sh && sh singbox_install_mirror.sh --version ${q_ver})) && rm -f singbox_install.sh singbox_install_mirror.sh && /etc/init.d/momo restart; } 2>&1`;
			}

			const process = popen(cmd);
			let output = '';
			if (process) {
				output = process.read('all');
				process.close();
			}
			return { result: output };
		}
	},
	check_profile: {
		args: { path: 'path' },
		call: function(req) {
			const path = req.args?.path ?? '/tmp/momo_editor.json';
			if (!match(path, /^\/(etc\/momo\/(profiles|subscriptions|run)\/[a-zA-Z0-9._-]+|tmp\/momo_editor)\.json$/)) {
				return { valid: false, output: 'Invalid profile path' };
			}
			const process = popen(`/usr/bin/sing-box check -D ${sh_quote(PATHS.run_dir)} -c ${sh_quote(path)} 2>&1`);
			let output = '';
			let code = -1;
			if (process) {
				output = trim(process.read('all'));
				code = process.close();
			}
			output = strip_ansi(output);
			return {
				valid: code == 0,
				output: output || (code == 0 ? 'Configuration check passed (valid).' : 'Check failed.')
			};
		}
	},
	format_profile: {
		args: { path: 'path' },
		call: function(req) {
			const path = req.args?.path ?? '/tmp/momo_editor.json';
			if (!match(path, /^\/(etc\/momo\/(profiles|subscriptions|run)\/[a-zA-Z0-9._-]+|tmp\/momo_editor)\.json$/)) {
				return { valid: false, output: 'Invalid profile path' };
			}
			const process = popen(`/usr/bin/sing-box format -D ${sh_quote(PATHS.run_dir)} -c ${sh_quote(path)} -w 2>&1`);
			let output = '';
			let code = -1;
			if (process) {
				output = trim(process.read('all'));
				code = process.close();
			}
			output = strip_ansi(output);
			return {
				valid: code == 0,
				output: output || (code == 0 ? 'Configuration formatted.' : 'Format failed.')
			};
		}
	},
	api: {
		args: { method: 'method', path: 'path', query: 'query', body: 'body' },
		call: function(req) {
			let result = {};

			const method = req.args?.method ?? 'GET';
			const path = req.args?.path ?? '';
			const query = req.args?.query;
			const body = req.args?.body;

			if (!match(method, /^(GET|POST|PUT|PATCH|DELETE)$/)) {
				return { error: 'Invalid HTTP method' };
			}
			if (!path || substr(path, 0, 1) != '/') {
				return { error: 'Invalid API path' };
			}

			const profile = load_profile();
			let api_listen = profile?.['experimental']?.['clash_api']?.['external_controller'];
			const api_secret = profile?.['experimental']?.['clash_api']?.['secret'];

			if (!api_listen) {
				return result;
			}
			if (substr(api_listen, 0, 1) == ':') {
				api_listen = '127.0.0.1' + api_listen;
			} else if (substr(api_listen, 0, 7) == '0.0.0.0') {
				api_listen = '127.0.0.1' + substr(api_listen, 7);
			} else if (substr(api_listen, 0, 4) == '[::]') {
				api_listen = '[::1]' + substr(api_listen, 4);
			}

			const url = `http://${api_listen}${path}`;
			let cmd = `curl -s --max-time 10 --request ${sh_quote(method)}`;
			if (api_secret) {
				cmd += ` --header ${sh_quote('Authorization: Bearer ' + api_secret)}`;
			}
			if (query) {
				cmd += ` --url-query ${sh_quote(query)}`;
			}
			if (body) {
				cmd += ` --data ${sh_quote(body)}`;
			}
			cmd += ` ${sh_quote(url)}`;

			const process = popen(cmd);
			if (process) {
				const raw = trim(process.read('all') ?? '');
				process.close();
				if (raw != '') {
					try {
						result = json(raw) ?? {};
					} catch (e) {
						result = { raw: raw };
					}
				}
			}

			return result;
		}
	},
	get_identifiers: {
		call: function() {
			const users = filter(get_users(), (x) => x != '');
			const groups = filter(get_groups(), (x) => x != '');
			const cgroups = filter(get_cgroups(), (x) => x != '' && index(x, 'services/momo') < 0);
			return { users: users, groups: groups, cgroups: cgroups };
		}
	},
	debug: {
		call: function() {
			const success = system(`${sh_quote(PATHS.debug_sh)} > ${sh_quote(PATHS.debug_log_path)}`) == 0;
			return { success: success };
		}
	}
};

return { 'luci.momo': methods };