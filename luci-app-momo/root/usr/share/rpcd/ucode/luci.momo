#!/usr/bin/ucode

'use strict';

import { popen } from 'fs';
import { get_paths, merge_exists, get_users, get_groups, get_cgroups, load_profile } from '/etc/momo/ucode/include.uc';

const methods = {
	get_paths: {
		call: function() {
			return get_paths();
		}
	},
	version: {
		call: function() {
			let process;
			let app = '';
			if (system('command -v opkg') == 0) {
				process = popen(`opkg list-installed luci-app-momo | cut -d ' ' -f 3`);
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			} else if (system('command -v apk') == 0) {
				process = popen(`apk list -I luci-app-momo | cut -d ' ' -f 1 | cut -d '-' -f 4`);
				if (process) {
					app = trim(process.read('all'));
					process.close();
				}
			}
			let core = '';
			process = popen(`sing-box version | grep sing-box | cut -d ' ' -f 3`);
			if (process) {
				core = trim(process.read('all'));
				process.close();
			}
			return { app: app, core: core };
		}
	},
	profile: {
		args: { defaults: {} },
		call: function(req) {
			const defaults = req.args?.defaults ?? {};
			const profile = load_profile();
			return merge_exists(defaults, profile);
		}
	},
	update_subscription: {
		args: { section_id: 'section_id' },
		call: function(req) {
			let success = false;
			const section_id = req.args?.section_id;
			if (section_id) {
				success = system(['service', 'momo', 'update_subscription', section_id]) == 0;
			}
			return { success: success };
		}
	},
	update_singbox: {
		args: { version: 'version', mirror: 'mirror' },
		call: function(req) {
			const version = req.args?.version;
			const mirror = req.args?.mirror ?? 'auto';
			if (!version || !match(version, /^[a-zA-Z0-9._-]+$/)) return { result: "Invalid version specified" };

			const raw_url = 'https://raw.githubusercontent.com/SagerNet/sing-box/refs/heads/testing/docs/installation/tools/install.sh';
			let cmd = '';

			if (mirror == 'ghfast') {
				cmd = `{ cd /tmp && curl -fsSL --connect-timeout 15 -o singbox_install.sh "https://ghfast.top/${raw_url}" && sed -i 's|https://github.com/|https://ghfast.top/https://github.com/|g' singbox_install.sh && sh singbox_install.sh --version ${version} && rm -f singbox_install.sh && /etc/init.d/momo restart; } 2>&1`;
			} else if (mirror == 'ghproxy') {
				cmd = `{ cd /tmp && curl -fsSL --connect-timeout 15 -o singbox_install.sh "https://gh-proxy.com/${raw_url}" && sed -i 's|https://github.com/|https://gh-proxy.com/https://github.com/|g' singbox_install.sh && sh singbox_install.sh --version ${version} && rm -f singbox_install.sh && /etc/init.d/momo restart; } 2>&1`;
			} else if (mirror == 'direct') {
				cmd = `{ cd /tmp && curl -fsSL --connect-timeout 15 "${raw_url}" | sh -s -- --version ${version} && /etc/init.d/momo restart; } 2>&1`;
			} else {
				cmd = `{ cd /tmp && (curl -fsSL --connect-timeout 10 -o singbox_install.sh "${raw_url}" || curl -fsSL --connect-timeout 15 -o singbox_install.sh "https://ghfast.top/${raw_url}" || curl -fsSL --connect-timeout 15 -o singbox_install.sh "https://gh-proxy.com/${raw_url}") && (sh singbox_install.sh --version ${version} || (echo "Direct GitHub download failed, retrying via mirror (ghfast.top)..." && sed 's|https://github.com/|https://ghfast.top/https://github.com/|g' singbox_install.sh > singbox_install_mirror.sh && sh singbox_install_mirror.sh --version ${version}) || (echo "Retrying via backup mirror (gh-proxy.com)..." && sed 's|https://github.com/|https://gh-proxy.com/https://github.com/|g' singbox_install.sh > singbox_install_mirror.sh && sh singbox_install_mirror.sh --version ${version})) && rm -f singbox_install.sh singbox_install_mirror.sh && /etc/init.d/momo restart; } 2>&1`;
			}

			const process = popen(cmd);
			let output = '';
			if (process) {
				output = process.read('all');
				process.close();
			}
			return { result: output };
		}
	},
	check_profile: {
		args: { path: 'path' },
		call: function(req) {
			const path = req.args?.path ?? '/tmp/momo_editor.json';
			if (!match(path, /^\/(etc\/momo\/(profiles|subscriptions|run)\/[a-zA-Z0-9._-]+|tmp\/momo_editor)\.json$/)) {
				return { valid: false, output: 'Invalid profile path' };
			}
			const process = popen(`/usr/bin/sing-box check -D /etc/momo/run -c '${path}' 2>&1`);
			let output = '';
			let code = -1;
			if (process) {
				output = trim(process.read('all'));
				code = process.close();
			}
			return {
				valid: code == 0,
				output: output || (code == 0 ? 'Configuration check passed (valid).' : 'Check failed.')
			};
		}
	},
	format_profile: {
		args: { path: 'path' },
		call: function(req) {
			const path = req.args?.path ?? '/tmp/momo_editor.json';
			if (!match(path, /^\/(etc\/momo\/(profiles|subscriptions|run)\/[a-zA-Z0-9._-]+|tmp\/momo_editor)\.json$/)) {
				return { valid: false, output: 'Invalid profile path' };
			}
			const process = popen(`/usr/bin/sing-box format -D /etc/momo/run -c '${path}' -w 2>&1`);
			let output = '';
			let code = -1;
			if (process) {
				output = trim(process.read('all'));
				code = process.close();
			}
			return {
				valid: code == 0,
				output: output || (code == 0 ? 'Configuration formatted.' : 'Format failed.')
			};
		}
	},
	api: {
		args: { method: 'method', path: 'path', query: 'query', body: 'body' },
		call: function(req) {
			let result = {};

			const method = req.args?.method;
			const path = req.args?.path;
			const query = req.args?.query;
			const body = req.args?.body;

			const profile = load_profile();
			const api_listen = profile?.['experimental']?.['clash_api']?.['external_controller'];
			const api_secret = profile?.['experimental']?.['clash_api']?.['secret'];

			if (!api_listen) {
				return result;
			}

			const url = api_listen + path;
			let cmd = `curl -s --request '${method}'`;
			if (api_secret) {
				cmd += ` --oauth2-bearer '${api_secret}'`;
			}
			if (query) {
				cmd += ` --url-query '${query}'`;
			}
			if (body) {
				cmd += ` --data '${body}'`;
			}
			cmd += ` '${url}'`;

			const process = popen(cmd);
			if (process) {
				result = json(process);
				process.close();
			}

			return result;
		}
	},
	get_identifiers: {
		call: function() {
			const users = filter(get_users(), (x) => x != '');
			const groups = filter(get_groups(), (x) => x != '');
			const cgroups = filter(get_cgroups(), (x) => x != '' && index(x, 'services/momo') < 0);
			return { users: users, groups: groups, cgroups: cgroups };
		}
	},
	debug: {
		call: function() {
			const paths = get_paths();
			const success = system(`${paths.debug_sh} > ${paths.debug_log_path}`) == 0;
			return { success: success };
		}
	}
};

return { 'luci.momo': methods };